FROM node:22-slim

WORKDIR /app/

COPY . .
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    build-essential \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

# Workspace install: one shared node_modules (single React) for packages + frontends
WORKDIR /app
RUN npm install

COPY .env /app/frontend/meradhan/

WORKDIR /app/frontend/meradhan
RUN npm run build

EXPOSE 4002

CMD ["npx", "next", "start", "-p", "4002", "-H", "0.0.0.0"]
