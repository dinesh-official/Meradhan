model CRMUserDataModel {
  id                     Int                      @id @default(autoincrement())
  name                   String
  email                  String                   @unique
  phoneNo                String
  avatar                 String?                  @default("person.jpg")
  lastLogin              DateTime?
  role                   CrmUserROLE              @default(VIEWER)
  accountStatus          AccountStatus            @default(ACTIVE)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  createdBy              Int?
  CustomersAuthDataModel CustomersAuthDataModel[]
  LeadsModel             LeadsModel[]

  @@index([email])
  @@map("crm_users")
}

// ------------------------------
// Customers MODELS SECTION
// ------------------------------

/// Stores authentication and account-related data for customers
model CustomersAuthDataModel {
  id Int @id @default(autoincrement())

  /// Encrypted password (optional if using social login)
  password String?

  /// Type of sign-in used (e.g., EMAIL, GOOGLE, etc.)
  signinWith SIGNIN_WITH

  /// Account status (e.g., ACTIVE, INACTIVE, SUSPENDED)
  accountStatus AccountStatus @default(ACTIVE)

  /// Verification flags
  isPhoneVerified           Boolean   @default(false)
  isEmailVerified           Boolean   @default(false)
  whatsAppNotificationAllow Boolean   @default(false)
  termsAccepted             Boolean   @default(false)
  lastLogin                 DateTime?

  relationshipManager      CRMUserDataModel?          @relation(fields: [cRMUserDataModelId], references: [id])
  CustomerProfileDataModel CustomerProfileDataModel[]

  /// Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  cRMUserDataModelId Int?

  @@map("customers_auth_data")
}

/// Stores customer profile information (public / account details)
model CustomerProfileDataModel {
  id Int @id @default(autoincrement())

  /// Basic identity info
  userName   String @unique
  firstName  String
  middleName String
  lastName   String
  gender     Gender

  /// Contact details
  emailAddress String  @unique
  phoneNo      String
  whatsAppNo   String?

  /// Profile visuals and type
  avatar   String?         @default("person.jpg")
  userType UserAccountType @default(INDIVIDUAL)

  /// KYC (Know Your Customer) related info
  kycStatus  KYCStatus @default(PENDING)
  VerifiedBy Int?

  riskProfile                 CustomersRiskProfileModel? @relation(fields: [customersRiskProfileModelId], references: [id])
  customersRiskProfileModelId Int?

  utility                  CustomersAuthDataModel @relation(fields: [customersAuthDataModelId], references: [id])
  customersAuthDataModelId Int

  createdBy Int?

  // data set 

  /// Relation with Aadhaar Card details
  aadhaarCard        AADHAARCardModel? @relation(fields: [aADHAARCardModelId], references: [id])
  aADHAARCardModelId Int?

  /// Relation with PAN Card details
  panCard        PanCardModel? @relation(fields: [panCardModelId], references: [id])
  panCardModelId Int?

  // profile info
  personalInformation         CustomerPersonalInfoModel? @relation(fields: [customerPersonalInfoModelId], references: [id])
  customerPersonalInfoModelId Int?

  /// Linked bank and demat accounts
  bankAccounts  CustomersBankAccountModel[]
  dematAccounts CustomersDematAccountModel[]

  /// Address relations (current and permanent)
  currentAddress        AddressModel? @relation("CurrentAddress", fields: [currentAddressModelId], references: [id])
  currentAddressModelId Int?

  permanentAddress        AddressModel? @relation("PermanentAddress", fields: [permanentAddressModelId], references: [id])
  permanentAddressModelId Int?

  nse          NSEDATASET? @relation(fields: [nSEDATASETId], references: [id])
  nSEDATASETId Int?
  /// Metadata and audit fields
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  /// Commonly searched fields for faster queries
  @@index([emailAddress, userName])
  /// Map to actual database table name
  @@map("customers_profile_data")
}

/// Stores customer's personal information and identity documents
model CustomerPersonalInfoModel {
  id Int @id @default(autoincrement())

  /// Signature image URL
  SignatureUrl String?

  /// Personal info
  maritalStatus            String
  occupationType           String
  annualGrossIncome        String
  fatherOrSpouseName       String
  mothersName              String
  nationality              String
  maidenName               String?
  residentialStatus        String
  qualification            String
  politicallyExposedPerson String?

  /// Timestamps
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  CustomerProfileDataModel CustomerProfileDataModel[]

  @@map("customers_personal_info")
}

/// Aadhaar card (identity proof) data model
model AADHAARCardModel {
  id Int @id @default(autoincrement())

  /// Name details as per Aadhaar
  firstName  String
  middleName String
  lastName   String

  /// Father’s name for verification
  fatherName String

  /// Aadhaar details
  aadhaarNo   String
  dateOfBirth String
  gender      Gender
  image       String

  /// Verification status
  isVerified Boolean  @default(false)
  verifyDate DateTime

  CustomerProfileDataModel CustomerProfileDataModel[]

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("aadhaar_cards")
}

/// PAN card (tax identity proof) data model
model PanCardModel {
  id Int @id @default(autoincrement())

  /// Name details as per PAN
  firstName  String
  middleName String
  lastName   String

  /// PAN card details
  panCardNo   String
  dateOfBirth String
  gender      Gender

  /// Verification status
  isVerified Boolean  @default(false)
  verifyDate DateTime

  CustomerProfileDataModel CustomerProfileDataModel[]

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pan_cards")
}

/// Bank account information linked to a customer
model CustomersBankAccountModel {
  id Int @id @default(autoincrement())

  /// Basic account info
  accountHolderName String
  bankAccountType   String
  accountNumber     String
  ifscCode          String
  bankName          String
  branch            String

  /// Status flags
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  CustomerProfileDataModel   CustomerProfileDataModel? @relation(fields: [customerProfileDataModelId], references: [id])
  customerProfileDataModelId Int?

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers_bank_accounts")
}

/// Demat / Broker account data (for trading accounts)
model CustomersDematAccountModel {
  id Int @id @default(autoincrement())

  /// Depository info
  depositoryName            DepositoryName
  dpId                      String
  clientId                  String
  accountType               DematAccountType
  depositoryParticipantName String

  /// PAN details linked to this account
  primaryPanNumber  String
  sndPanNumber      String?
  trdPanNumber      String?
  accountHolderName String

  /// Status flags
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  CustomerProfileDataModel   CustomerProfileDataModel? @relation(fields: [customerProfileDataModelId], references: [id])
  customerProfileDataModelId Int?

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers_demat_accounts")
}

/// Risk profile of a customer (e.g., low / medium / high risk)
model CustomersRiskProfileModel {
  id Int @id @default(autoincrement())

  data Json[]

  /// Timestamps
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  CustomerProfileDataModel CustomerProfileDataModel[]

  @@map("customers_risk_profiles")
}

/// Address model (used for both current and permanent addresses)
model AddressModel {
  id Int @id @default(autoincrement())

  /// Address lines
  line1 String
  line2 String?
  line3 String?

  /// Location details
  postOffice     String
  cityOrDistrict String
  state          String
  pinCode        String
  country        String

  /// Full address text
  fullAddress String

  /// Reverse relations (used by personal info)
  currentAddressOf   CustomerProfileDataModel[] @relation("CurrentAddress")
  permanentAddressOf CustomerProfileDataModel[] @relation("PermanentAddress")

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

/// Defines CRM user roles with varying access levels
enum CrmUserROLE {
  /// Can only view data, no modifications allowed
  VIEWER
  /// Full access to all operations
  ADMIN
  /// Handles lead generation and conversion
  SALES
  /// Manages customer issues and support requests
  SUPPORT
  /// Assigned relationship manager for customers
  RELATIONSHIP_MANAGER
}

/// Defines overall account status for a customer
enum AccountStatus {
  /// Account is active and usable
  ACTIVE
  /// Account is temporarily or permanently suspended
  SUSPENDED
}

/// Indicates the login/sign-in method used
enum SIGNIN_WITH {
  /// Default: Email and password-based login
  CREDENTIALS
  /// Google account sign-in
  GOOGLE
  /// Microsoft account sign-in
  MICROSOFT
}

/// Represents type of user account (based on entity type)
enum UserAccountType {
  INDIVIDUAL
  INDIVIDUAL_NRI_NRO
  TRUST
  CORPORATE
  HUF
  LLP
  PARTNERSHIP_FIRM
}

/// Gender information for customers
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Type of depository for Demat accounts
enum DepositoryName {
  NSDL
  CDSL
}

/// Type of Demat (trading) account ownership
enum DematAccountType {
  SINGLE
  JOINT
  HUF
}

/// KYC (Know Your Customer) verification status
enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Lead Sources
enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL
  ADVERTISEMENT
  EVENT
  COLD_CALL
  EMAIL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum BondType {
  GOVERNMENT
  CORPORATE
  TAX_FREE
  SOVEREIGN_GOLD_BOND
  PSU
  OTHER
}

model LeadsModel {
  id Int @id @default(autoincrement())

  fullName           String
  emailAddress       String
  phoneNo            String
  companyName        String
  leadSource         LeadSource
  bondType           BondType
  status             LeadStatus
  exInvestmentAmount Int?
  note               String?
  assignTo           CRMUserDataModel? @relation(fields: [cRMUserDataModelId], references: [id])
  createdBy          Int

  /// Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  cRMUserDataModelId Int?

  @@map("leads")
}

model LeadFollowUpNotesModel {
  id     Int @id @default(autoincrement())
  leadId Int

  createdByName String
  createdByID   Int
  text          String
  nextDate      DateTime?

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads_follow_up_notes")
}

model NSEDATASET {
  id                       Int                        @id @default(autoincrement())
  CustomerProfileDataModel CustomerProfileDataModel[]

  participant                 NSECbricsParticipantModel @relation(fields: [nSECbricsParticipantModelId], references: [id])
  nSECbricsParticipantModelId Int
}

model NSECbricsParticipantModel {
  id      Int    @unique
  loginId String @unique

  actualStatus   Int
  workflowStatus Int
  firstName      String
  panNo          String
  custodian      String?
  contactPerson  String
  mobileList     String[]
  emailList      String[]
  telephone      String
  fax            String?
  address        String?
  address2       String?
  address3       String?
  stateCode      String
  regAddress     String
  leiCode        String?
  expiryDate     DateTime?
  panVerStatus   Int?
  panVerRemarks  String?
  remarks        String?

  bankAccountList NSEBankAccount[]
  dpAccountList   NSEDpAccount[]

  /// Timestamps
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  NSEDATASET NSEDATASET[]

  @@map("NSE_cbrics_unregistered_participant")
}

model NSEBankAccount {
  id Int @id @default(autoincrement())

  bankName       String
  bankIFSC       String
  bankAccountNo  String
  isDefault      DefaultSelect
  workflowStatus Int?
  status         String?

  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  NSECbricsParticipantModel   NSECbricsParticipantModel? @relation(fields: [nSECbricsParticipantModelId], references: [id])
  nSECbricsParticipantModelId Int?

  @@map("NSE_cbrics_bank_account")
}

model NSEDpAccount {
  id Int @id @default(autoincrement())

  dpType         DepositoryName
  dpId           String?
  benId          String
  isDefault      DefaultSelect
  workflowStatus Int?
  status         String?

  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  NSECbricsParticipantModel   NSECbricsParticipantModel? @relation(fields: [nSECbricsParticipantModelId], references: [id])
  nSECbricsParticipantModelId Int?

  @@map("NSE_cbrics_dp_account")
}

enum DefaultSelect {
  Y
  N
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../generated/prisma/supabase"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
