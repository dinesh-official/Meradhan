model CrmAuditLogs {
  id        Int      @id @default(autoincrement())
  userId    Int?
  type      String
  token     String?
  url       String?
  data      Json
  createdAt DateTime @default(now())

  @@map("crm_audit_logs")
}

model CRMUserDataModel {
  id                     Int                      @id @default(autoincrement())
  name                   String
  email                  String                   @unique
  phoneNo                String
  avatar                 String?                  @default("person.jpg")
  lastLogin              DateTime?
  role                   CrmUserROLE              @default(VIEWER)
  accountStatus          AccountStatus            @default(ACTIVE)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  createdBy              Int?
  CustomersAuthDataModel CustomersAuthDataModel[]
  LeadsModel             LeadsModel[]

  @@index([email])
  @@map("crm_users")
}

/// Stores authentication and account-related data for customers
model CustomersAuthDataModel {
  id Int @id @default(autoincrement())

  /// Encrypted password (optional if using social login)
  password String?

  /// Type of sign-in used (e.g., EMAIL, GOOGLE, etc.)
  signinWith SIGNIN_WITH

  /// Account status (e.g., ACTIVE, INACTIVE, SUSPENDED)
  accountStatus AccountStatus @default(ACTIVE)

  /// Verification flags
  isPhoneVerified           Boolean   @default(false)
  isEmailVerified           Boolean   @default(false)
  whatsAppNotificationAllow Boolean   @default(false)
  termsAccepted             Boolean   @default(false)
  lastLogin                 DateTime?

  relationshipManager CRMUserDataModel? @relation(fields: [cRMUserDataModelId], references: [id])
  cRMUserDataModelId  Int?

  // One-to-one relation with CustomerProfileDataModel
  customerProfileDataModel CustomerProfileDataModel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers_auth_data")
}

/// Stores customer profile information (public / account details)
model CustomerProfileDataModel {
  id Int @id @default(autoincrement())

  /// Basic identity info
  userName   String @unique
  firstName  String
  middleName String
  lastName   String
  gender     Gender

  /// Contact details
  emailAddress String  @unique
  phoneNo      String
  whatsAppNo   String?

  /// Profile visuals and type
  avatar   String?         @default("person.jpg")
  userType UserAccountType @default(INDIVIDUAL)

  /// KYC (Know Your Customer) related info
  kycStatus  KYCStatus @default(PENDING)
  VerifiedBy Int?
  verifyDate DateTime?

  // One-to-one relations
  riskProfile                 CustomersRiskProfileModel? @relation(fields: [customersRiskProfileModelId], references: [id], onDelete: Cascade)
  customersRiskProfileModelId Int?                       @unique

  utility                  CustomersAuthDataModel @relation(fields: [customersAuthDataModelId], references: [id], onDelete: Cascade)
  customersAuthDataModelId Int                    @unique

  aadhaarCard        AADHAARCardModel? @relation(fields: [aADHAARCardModelId], references: [id], onDelete: Cascade)
  aADHAARCardModelId Int?              @unique

  panCard        PanCardModel? @relation(fields: [panCardModelId], references: [id], onDelete: Cascade)
  panCardModelId Int?          @unique

  personalInformation         CustomerPersonalInfoModel? @relation(fields: [customerPersonalInfoModelId], references: [id], onDelete: Cascade)
  customerPersonalInfoModelId Int?                       @unique

  currentAddress        AddressModel? @relation("CurrentAddress", fields: [currentAddressModelId], references: [id], onDelete: Cascade)
  currentAddressModelId Int?          @unique

  permanentAddress        AddressModel? @relation("PermanentAddress", fields: [permanentAddressModelId], references: [id], onDelete: Cascade)
  permanentAddressModelId Int?          @unique

  // Linked accounts
  bankAccounts  CustomersBankAccountModel[]
  dematAccounts CustomersDematAccountModel[]

  nseDataSet NseDataSet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?

  @@index([emailAddress, userName])
  @@map("customers_profile_data")
}

/// Stores customer's personal information and identity documents (1:1)
model CustomerPersonalInfoModel {
  id Int @id @default(autoincrement())

  SignatureUrl String?

  maritalStatus            String
  occupationType           String
  annualGrossIncome        String
  fatherOrSpouseName       String
  relationshipWithPerson   String?
  mothersName              String
  nationality              String
  maidenName               String?
  residentialStatus        String
  qualification            String
  politicallyExposedPerson String?
  dateOfBirth              String?

  // 1-to-1 back reference
  customerProfileDataModel CustomerProfileDataModel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers_personal_info")
}

/// Aadhaar card (identity proof) data model (1:1)
model AADHAARCardModel {
  id Int @id @default(autoincrement())

  firstName   String
  middleName  String
  lastName    String
  fatherName  String
  aadhaarNo   String
  dateOfBirth String
  gender      Gender
  image       String

  isVerified Boolean  @default(false)
  verifyDate DateTime

  // 1-to-1 back reference
  customerProfileDataModel CustomerProfileDataModel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("aadhaar_cards")
}

/// PAN card (tax identity proof) data model (1:1)
model PanCardModel {
  id Int @id @default(autoincrement())

  firstName   String
  middleName  String
  lastName    String
  panCardNo   String
  dateOfBirth String
  gender      Gender

  isVerified Boolean  @default(false)
  verifyDate DateTime

  // 1-to-1 back reference
  customerProfileDataModel CustomerProfileDataModel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pan_cards")
}

/// Risk profile of a customer (1:1)
model CustomersRiskProfileModel {
  id Int @id @default(autoincrement())

  data Json

  // 1-to-1 back reference
  customerProfileDataModel CustomerProfileDataModel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers_risk_profiles")
}

/// Address model (1:1 used for both current and permanent)
model AddressModel {
  id Int @id @default(autoincrement())

  line1          String
  line2          String?
  line3          String?
  postOffice     String
  cityOrDistrict String
  state          String
  pinCode        String
  country        String
  fullAddress    String

  // Reverse relations (1:1)
  currentAddressOf   CustomerProfileDataModel? @relation("CurrentAddress")
  permanentAddressOf CustomerProfileDataModel? @relation("PermanentAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

/// Bank account information linked to a customer (1-to-many)
model CustomersBankAccountModel {
  id Int @id @default(autoincrement())

  accountHolderName String
  bankAccountType   String
  accountNumber     String
  ifscCode          String
  bankName          String
  branch            String

  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(false)
  verifyDate DateTime

  CustomerProfileDataModel   CustomerProfileDataModel? @relation(fields: [customerProfileDataModelId], references: [id])
  customerProfileDataModelId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers_bank_accounts")
}

/// Demat / Broker account data (1-to-many)
model CustomersDematAccountModel {
  id Int @id @default(autoincrement())

  depositoryName            DepositoryName
  dpId                      String
  clientId                  String
  accountType               DematAccountType
  depositoryParticipantName String

  primaryPanNumber  String
  sndPanNumber      String?
  trdPanNumber      String?
  accountHolderName String

  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(false)
  verifyDate DateTime

  CustomerProfileDataModel   CustomerProfileDataModel? @relation(fields: [customerProfileDataModelId], references: [id])
  customerProfileDataModelId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers_demat_accounts")
}

/// Defines CRM user roles with varying access levels
enum CrmUserROLE {
  /// Can only view data, no modifications allowed
  VIEWER
  /// Full access to all operations
  ADMIN
  /// Handles lead generation and conversion
  SALES
  /// Manages customer issues and support requests
  SUPPORT
  /// Assigned relationship manager for customers
  RELATIONSHIP_MANAGER
}

/// Defines overall account status for a customer
enum AccountStatus {
  /// Account is active and usable
  ACTIVE
  /// Account is temporarily or permanently suspended
  SUSPENDED
}

/// Indicates the login/sign-in method used
enum SIGNIN_WITH {
  /// Default: Email and password-based login
  CREDENTIALS
  /// Google account sign-in
  GOOGLE
  /// Microsoft account sign-in
  MICROSOFT
}

/// Represents type of user account (based on entity type)
enum UserAccountType {
  INDIVIDUAL
  INDIVIDUAL_NRI_NRO
  TRUST
  CORPORATE
  HUF
  LLP
  PARTNERSHIP_FIRM
}

/// Gender information for customers
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Type of depository for Demat accounts
enum DepositoryName {
  NSDL
  CDSL
}

/// Type of Demat (trading) account ownership
enum DematAccountType {
  SINGLE
  JOINT
  HUF
}

/// KYC (Know Your Customer) verification status
enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Lead Sources
enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL
  ADVERTISEMENT
  EVENT
  COLD_CALL
  EMAIL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum BondType {
  GOVERNMENT
  CORPORATE
  TAX_FREE
  SOVEREIGN_GOLD_BOND
  PSU
  OTHER
}

model LeadsModel {
  id Int @id @default(autoincrement())

  fullName           String
  emailAddress       String
  phoneNo            String
  companyName        String
  leadSource         LeadSource
  bondType           BondType
  status             LeadStatus
  exInvestmentAmount Int?
  note               String?
  assignTo           CRMUserDataModel? @relation(fields: [cRMUserDataModelId], references: [id])
  createdBy          Int

  /// Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  cRMUserDataModelId Int?

  @@map("leads")
}

model LeadFollowUpNotesModel {
  id     Int @id @default(autoincrement())
  leadId Int

  createdByName String
  createdByID   Int
  text          String
  nextDate      DateTime?

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads_follow_up_notes")
}

model NseDataSet {
  id Int @id @default(autoincrement())

  // One-to-one relationship with CustomerProfileDataModel
  customerProfileDataModelId Int                      @unique
  customerProfileDataModel   CustomerProfileDataModel @relation(fields: [customerProfileDataModelId], references: [id], onDelete: Cascade)

  participant                 NseCbricsParticipantModel @relation(fields: [nseCbricsParticipantModelId], references: [id])
  nseCbricsParticipantModelId Int

  @@map("nse_customer_data_set")
}

model NseCbricsParticipantModel {
  key Int @id @default(autoincrement())

  id             Int       @unique
  loginId        String    @unique
  userId         Int       @unique
  actualStatus   Int
  workflowStatus Int
  firstName      String
  panNo          String
  custodian      String?
  contactPerson  String
  mobileList     String[]
  emailList      String[]
  telephone      String
  fax            String?
  address        String?
  address2       String?
  address3       String?
  stateCode      String
  regAddress     String
  leiCode        String?
  expiryDate     DateTime?
  panVerStatus   Int?
  panVerRemarks  String?
  remarks        String?

  bankAccountList NSEBankAccount[]
  dpAccountList   NSEDpAccount[]

  /// Timestamps
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  NSEDATASET NseDataSet[]

  @@map("nse_cbrics_unregistered_participant")
}

model NSEBankAccount {
  id Int @id @default(autoincrement())

  bankName       String
  bankIFSC       String
  bankAccountNo  String
  isDefault      DefaultSelect
  workflowStatus Int?
  status         String?

  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  NSECbricsParticipantModel   NseCbricsParticipantModel? @relation(fields: [nseCbricsParticipantModelId], references: [id])
  nseCbricsParticipantModelId Int?

  @@map("nse_cbrics_bank_account")
}

model NSEDpAccount {
  id Int @id @default(autoincrement())

  dpType         DepositoryName
  dpId           String?
  benId          String
  isDefault      DefaultSelect
  workflowStatus Int?
  status         String?

  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  NSECbricsParticipantModel   NseCbricsParticipantModel? @relation(fields: [nseCbricsParticipantModelId], references: [id])
  nseCbricsParticipantModelId Int?

  @@map("nse_cbrics_dp_account")
}

enum DefaultSelect {
  Y
  N
}

model NseIsinSecurityReceipt {
  id            Int      @id @default(autoincrement())
  symbol        String   @unique
  couponRate    Float
  issueCategory String
  listed        String
  maturityDate  DateTime
  faceValue     Float
  description   String
  type          String
  issuer        String

  @@map("nse_isin_security_receipts")
}

model NSERfqModel {
  key             Int         @id @default(autoincrement())
  number          String      @unique
  segment         String
  isin            String
  date            String
  participantCode String
  dealType        DealType
  clientCode      String
  buySell         BuySell
  quoteType       QuoteType
  settlementType  Int
  value           Float
  quantity        Int?
  yieldType       YieldType
  yield           Float
  calcMethod      CalcMethod
  price           Float?
  valueSell       Float?
  quantitySell    Int?
  yieldTypeSell   YieldType?
  yieldSell       Float?
  calcMethodSell  CalcMethod?
  priceSell       Float?
  gtdFlag         String?
  endTime         String?
  quoteNegotiable String?
  valueNegotiable String?
  minFillValue    Float?
  valueStepSize   Float?
  anonymous       String?
  access          Int
  groupList       Int[]
  participantList String[]
  category        String?
  rating          String?
  remarks         String?
  status          RFQStatus
  userLogin       String
  tradedValue     Float
  confirmedValue  Float
  clientRegType   String
  quoteTime       String
}

enum DealType {
  D
  B
}

enum BuySell {
  B
  S
  X
}

enum QuoteType {
  Y
  B
}

enum YieldType {
  YTM
  YTP
  YTC
}

enum CalcMethod {
  M
  O
}

enum RFQStatus {
  P
  W
  T
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../generated/prisma/supabase"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
