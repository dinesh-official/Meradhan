model NseDataSet {
    id Int @id @default(autoincrement())

    // One-to-one relationship with CustomerProfileDataModel
    customerProfileDataModelId Int                      @unique
    customerProfileDataModel   CustomerProfileDataModel @relation(fields: [customerProfileDataModelId], references: [id], onDelete: Cascade)

    participant                 NseCbricsParticipantModel @relation(fields: [nseCbricsParticipantModelId], references: [id])
    nseCbricsParticipantModelId Int

    @@map("nse_customer_data_set")
}

model NseCbricsParticipantModel {
    key Int @id @default(autoincrement())

    id             Int       @unique
    loginId        String    @unique
    userId         Int       @unique
    actualStatus   Int
    workflowStatus Int
    firstName      String
    panNo          String
    custodian      String?
    contactPerson  String
    mobileList     String[]
    emailList      String[]
    telephone      String
    fax            String?
    address        String?
    address2       String?
    address3       String?
    stateCode      String
    regAddress     String
    leiCode        String?
    expiryDate     DateTime?
    panVerStatus   Int?
    panVerRemarks  String?
    remarks        String?

    bankAccountList NSEBankAccount[]
    dpAccountList   NSEDpAccount[]

    /// Timestamps
    createdAt  DateTime     @default(now())
    updatedAt  DateTime     @updatedAt
    NSEDATASET NseDataSet[]

    @@map("nse_cbrics_unregistered_participant")
}

model NSEBankAccount {
    id Int @id @default(autoincrement())

    bankName       String
    bankIFSC       String
    bankAccountNo  String
    isDefault      DefaultSelect
    workflowStatus Int?
    status         String?

    createdAt                   DateTime                   @default(now())
    updatedAt                   DateTime                   @updatedAt
    NSECbricsParticipantModel   NseCbricsParticipantModel? @relation(fields: [nseCbricsParticipantModelId], references: [id])
    nseCbricsParticipantModelId Int?

    @@map("nse_cbrics_bank_account")
}

model NSEDpAccount {
    id Int @id @default(autoincrement())

    dpType         DepositoryName
    dpId           String?
    benId          String
    isDefault      DefaultSelect
    workflowStatus Int?
    status         String?

    createdAt                   DateTime                   @default(now())
    updatedAt                   DateTime                   @updatedAt
    NSECbricsParticipantModel   NseCbricsParticipantModel? @relation(fields: [nseCbricsParticipantModelId], references: [id])
    nseCbricsParticipantModelId Int?

    @@map("nse_cbrics_dp_account")
}

enum DefaultSelect {
    Y
    N
}

model NseIsinSecurityReceipt {
    id            Int      @id @default(autoincrement())
    symbol        String   @unique
    couponRate    Float
    issueCategory String
    listed        String
    maturityDate  DateTime
    faceValue     Float
    description   String
    type          String
    issuer        String

    @@map("nse_isin_security_receipts")
}

model NSERfqModel {
    key             Int         @id @default(autoincrement())
    number          String      @unique
    segment         String
    isin            String
    date            String
    participantCode String
    dealType        DealType
    clientCode      String
    buySell         BuySell
    quoteType       QuoteType
    settlementType  Int
    value           Float
    quantity        Int?
    yieldType       YieldType
    yield           Float
    calcMethod      CalcMethod
    price           Float?
    valueSell       Float?
    quantitySell    Int?
    yieldTypeSell   YieldType?
    yieldSell       Float?
    calcMethodSell  CalcMethod?
    priceSell       Float?
    gtdFlag         String?
    endTime         String?
    quoteNegotiable String?
    valueNegotiable String?
    minFillValue    Float?
    valueStepSize   Float?
    anonymous       String?
    access          Int
    groupList       Int[]
    participantList String[]
    category        String?
    rating          String?
    remarks         String?
    status          RFQStatus
    userLogin       String
    tradedValue     Float
    confirmedValue  Float
    clientRegType   String
    quoteTime       String
}

enum DealType {
    D
    B
}

enum BuySell {
    B
    S
    X
}

enum QuoteType {
    Y
    B
}

enum YieldType {
    YTM
    YTP
    YTC
}

enum CalcMethod {
    M
    O
}

enum RFQStatus {
    P
    W
    T
}
