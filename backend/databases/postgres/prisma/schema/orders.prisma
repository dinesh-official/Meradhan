model Order {
    id Int @id @default(autoincrement())

    orderNumber String @unique // For user reference (e.g., ORD-123456)

    /// Owning Meradhan customer for this order. Null for orders whose
    /// counterparty is an external NSE RFQ participant rather than one of
    /// our customers (`linkedRfqParticipantCode` is set in that case).
    customerProfileId Int?
    customerProfile   CustomerProfileDataModel? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

    /// When the counterparty is an external NSE RFQ participant, this is the
    /// `nse_rfq_participant_info.code`. Mutually exclusive with
    /// `customerProfileId` at the business level — exactly one of the two is
    /// expected to be set for any Order created through the CRM
    /// assign-counterparty flow.
    linkedRfqParticipantCode String? @db.VarChar(64)

    // Payment Details (Generic)
    paymentProvider String? // e.g., "RAZORPAY"
    paymentOrderId  String? @unique // Provider's Order ID (e.g., order_123)
    paymentId       String? @unique // Provider's Payment ID (e.g., pay_123)
    transferId      String? // Provider's Payment ID (e.g., pay_123)
    paymentMetadata Json? // Store signature, method, vpa, etc. here

    paymentStatus PaymentStatus @default(PENDING)
    status        OrderStatus   @default(PENDING)

    // Financials
    subTotal    Decimal @db.Decimal(15, 2)
    stampDuty   Decimal @db.Decimal(15, 2)
    totalAmount Decimal @db.Decimal(15, 2)

    // Bond Snapshot (Single bond per order)
    isin        String
    bondName    String
    faceValue   Decimal @db.Decimal(15, 2)
    quantity    Int
    unitPrice   Decimal @db.Decimal(15, 2)
    bondDetails Json // Full bond details

    // Relations
    customerBonds CustomerBonds?
    orderLogs     OrderLogs[]

    // General Metadata
    metadata       Json?
    reqOrderNumber String?

    // 24/7 trading: when set, the trade is submitted to NSE at this instant
    // (next market open) by the scheduler cron instead of immediately on payment.
    // Cleared once the settlement job has been enqueued.
    scheduledExecutionAt DateTime?

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([paymentOrderId])
    @@index([paymentId])
    @@index([orderNumber])
    @@index([scheduledExecutionAt])
    @@index([linkedRfqParticipantCode])
    @@map("orders")
}

model CustomerBonds {
    id Int @id @default(autoincrement())

    customerProfileId Int
    customerProfile   CustomerProfileDataModel @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

    orderId Int   @unique // One order links to one customer bond
    order   Order @relation(fields: [orderId], references: [id])

    // Snapshot of bond details at purchase (decoupled from Bonds table)
    isin          String
    bondName      String
    faceValue     Decimal  @db.Decimal(15, 2)
    quantity      Int
    purchasePrice Decimal  @db.Decimal(15, 2)
    purchaseDate  DateTime @default(now())

    metadata Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([customerProfileId])
    @@index([isin])
    @@map("customer_bonds")
}

model OrderLogs {
    id Int @id @default(autoincrement())

    orderId Int
    order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    step   String // e.g. "RFQ_CREATED", "NEGOTIATION_ACCEPTED"
    status String // "SUCCESS", "FAILED", "PENDING"

    // To store specific IDs or results
    outputData Json?

    // To store what happened (errors, full API response for debugging)
    details Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([orderId])
    @@map("order_logs")
}

/// Separate settlement automation logs keyed by paymentId/batchId.
/// Kept standalone intentionally so existing order relations/flows remain untouched.
model OrderSettlementAutomationLog {
    id Int @id @default(autoincrement())

    orderId   Int?
    paymentId String
    batchId   String

    step   String
    status String

    message    String?
    inputData  Json?
    outputData Json?
    errorData  Json?

    startedAt   DateTime?
    completedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([paymentId])
    @@index([batchId])
    @@index([paymentId, batchId])
    @@index([orderId])
    @@map("order_settlement_automation_logs")
}

/**
 * CRM settle-order PDF generator form fields (keyed by NSE settle / req order number).
 */
model CrmOrderReceiptPdfOptions {
    id Int @id @default(autoincrement())

    orderNumber String @unique

    accruedInterestDays Int?
    settlementNumber    String?
    settlementDateTime  String?

    lastInterestPaymentDateRaw String?
    lastInterestPaymentDate    String?
    interestPaymentDates       String?

    nonAmortizedBond               Boolean @default(true)
    amortizedPrincipalPaymentDates String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("crm_order_receipt_pdf_options")
}

enum PaymentStatus {
    PENDING
    COMPLETED
    REFUNDED
    CANCELLED
}

enum OrderStatus {
    PENDING
    SETTLED
    APPLIED
    REJECTED
    // new added - 13 May 2026
    EXPIRED
    CANCELLED
    IN_PROGRESS
}

model DraftOrders {
    id          Int         @id @default(autoincrement())
    isin        String
    quantity    Float
    sellPrice   Float
    userId      Int
    pricingData Json?
    status      OrderStatus @default(PENDING)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    @@map("draft_orders")
}
